# Copy to terraform.tfvars (gitignored) and edit.

owner       = "matt.dorn@datadoghq.com"
region      = "us-east-2"
aws_profile = "sandbox" # or remove to use the default credential chain

# instance_type    = "t3.small"   # needed if install_datadog_agent = true
# ami_name_pattern = "ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-2023*"

# Optional Datadog Agent on the instance
install_datadog_agent = false
# datadog_api_key     = "..."     # better: export TF_VAR_datadog_api_key
datadog_site = "datadoghq.com"
