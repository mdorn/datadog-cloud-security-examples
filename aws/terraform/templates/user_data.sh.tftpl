#!/bin/bash
# Rendered by Terraform (ec2.tf). Bash variables are written as $VAR, never with braces,
# because braces after a dollar sign are Terraform interpolation.
set -euxo pipefail
exec > >(tee -a /var/log/lab-bootstrap.log) 2>&1

# ---------------------------------------------------------------------------
# 1. INTENTIONAL: freeze the old AMI. No unattended upgrades, so host CVEs stay.
# ---------------------------------------------------------------------------
systemctl stop unattended-upgrades.service apt-daily.timer apt-daily-upgrade.timer || true
systemctl disable unattended-upgrades.service apt-daily.timer apt-daily-upgrade.timer || true
systemctl mask apt-daily.service apt-daily-upgrade.service || true
cat > /etc/apt/apt.conf.d/99-lab-no-auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "0";
APT::Periodic::Unattended-Upgrade "0";
EOF

# ---------------------------------------------------------------------------
# 2. Docker (install only, no dist-upgrade)
# ---------------------------------------------------------------------------
export DEBIAN_FRONTEND=noninteractive
APT_OPTS="-o DPkg::Lock::Timeout=600 -y --no-install-recommends"
apt-get -o DPkg::Lock::Timeout=600 update
apt-get $APT_OPTS install docker.io
systemctl enable --now docker

# ---------------------------------------------------------------------------
# 3. Write the app files shipped in user data
# ---------------------------------------------------------------------------
APP_DIR=/opt/todo-app
mkdir -p $APP_DIR /opt/todo-data
%{ for path, content in app_files ~}
mkdir -p "$(dirname "$APP_DIR/${path}")"
echo '${content}' | base64 -d > "$APP_DIR/${path}"
%{ endfor ~}

%{ if install_datadog_agent ~}
# ---------------------------------------------------------------------------
# 4. Optional: Datadog Agent. Installed before the app starts so the first traces land.
#    Config files are written in full (not patched) so every feature is explicit:
#    APM for the container, Remote Configuration (App and API Protection), SBOM for the
#    host and container images (vulnerabilities), compliance (misconfigurations) and
#    runtime security (Workload Protection).
#    Note: with Cloud Security vulns + misconfigs on in the Agent, Agentless skips this host.
# ---------------------------------------------------------------------------
set +x # keep the API key out of the bootstrap log
DD_API_KEY='${datadog_api_key}' \
DD_SITE='${datadog_site}' \
DD_INSTALL_ONLY=true \
bash -c "$(curl -fsSL https://install.datadoghq.com/scripts/install_script_agent7.sh)"

cat > /etc/datadog-agent/datadog.yaml <<'EOF'
api_key: ${datadog_api_key}
site: ${datadog_site}
tags:
  - env:attack-path-lab
  - project:dd-attack-path-lab

remote_configuration:
  enabled: true

apm_config:
  enabled: true
  # The app container reaches the Agent on the docker bridge (host.docker.internal:8126).
  # Port 8126 is not open in the security group; only port 80 is.
  apm_non_local_traffic: true

process_config:
  process_collection:
    enabled: true

container_image:
  enabled: true

sbom:
  enabled: true
  container_image:
    enabled: true
    analyzers: ["os", "languages"]
  host:
    enabled: true
    analyzers: ["os", "languages"]

compliance_config:
  enabled: true
  host_benchmarks:
    enabled: true
EOF

cat > /etc/datadog-agent/system-probe.yaml <<'EOF'
runtime_security_config:
  enabled: true
EOF

cat > /etc/datadog-agent/security-agent.yaml <<'EOF'
runtime_security_config:
  enabled: true
compliance_config:
  enabled: true
  host_benchmarks:
    enabled: true
EOF

chown root:dd-agent /etc/datadog-agent/datadog.yaml /etc/datadog-agent/system-probe.yaml /etc/datadog-agent/security-agent.yaml
chmod 640 /etc/datadog-agent/datadog.yaml /etc/datadog-agent/system-probe.yaml /etc/datadog-agent/security-agent.yaml
usermod -aG docker dd-agent
systemctl enable datadog-agent
systemctl restart datadog-agent
set -x
%{ endif ~}

# ---------------------------------------------------------------------------
# 5. Build and run the container
# ---------------------------------------------------------------------------
docker build \
  --build-arg DD_GIT_REPOSITORY_URL='${git_repository_url}' \
  --build-arg DD_GIT_COMMIT_SHA='${git_commit_sha}' \
  -t todo-app:lab $APP_DIR
docker rm -f todo-app 2>/dev/null || true
docker run -d \
  --name todo-app \
  --restart unless-stopped \
  -p 80:5000 \
  -v /opt/todo-data:/data \
  --add-host=host.docker.internal:host-gateway \
  -e DD_AGENT_HOST=host.docker.internal \
  -l com.datadoghq.tags.env=attack-path-lab \
  -l com.datadoghq.tags.service=todo-app \
  -l com.datadoghq.tags.version=0.1.0 \
  todo-app:lab

echo "lab bootstrap complete"
